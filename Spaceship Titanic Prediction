    "# Define the columns to apply polynomial features\n",
    "numerical_cols = ['Age', 'RoomService', 'FoodCourt', 'ShoppingMall', 'Spa', 'VRDeck']\n",
    "\n",
    "# Initialize the PolynomialFeatures object\n",
    "poly = PolynomialFeatures(degree=3, include_bias=False)\n",
    "\n",
    "# Fit on training data and transform both training and test data\n",
    "train_poly = poly.fit_transform(df_train[numerical_cols])\n",
    "test_poly = poly.transform(df_test[numerical_cols])\n",
    "\n",
    "# Create a DataFrame with the transformed features\n",
    "poly_feature_names = poly.get_feature_names_out(numerical_cols)  # Get names of new features\n",
    "df_train_poly = pd.DataFrame(train_poly, columns=poly_feature_names, index=df_train.index)\n",
    "df_test_poly = pd.DataFrame(test_poly, columns=poly_feature_names, index=df_test.index)\n",
    "\n",
    "# Merge the polynomial features back into the original DataFrame if needed\n",
    "df_train = pd.concat([df_train.drop(columns=numerical_cols), df_train_poly], axis=1)\n",
    "df_test = pd.concat([df_test.drop(columns=numerical_cols), df_test_poly], axis=1)"
   ]
